  "posts": {
    "archive": {
      "author": "paperghost",
      "title": "Who gets to keep the last copy?",
      "excerpt": "Our local print room is closing. We have one shelf of zines and no agreement on where it should go.",
      "comments": 38,
      "tag": "Community archives",
      "body": "The library can keep them behind a desk, or we can build a lending shelf in the café. One feels safe. The other feels alive. Has anyone found a way to do both?",
      "reply": "foldedmap: We made a shared catalogue and let contributors choose which copies could travel."
    },
    "zine": {
      "author": "slowtype",
      "title": "A reading group for things we never finished",
      "excerpt": "Bring an unfinished essay, a half-bound book, or just a question. Thursday, after the last bus.",
      "comments": 16,
      "tag": "Meet-ups",
      "body": "No presentation and no finished work required. We are meeting at the studio to read a paragraph out loud and leave the rest open.",
      "reply": "inkweather: I can bring a book that has been “nearly finished” for three years."
    },
